<?php

namespace App\Services;

use App\Models\Booking;
use App\Models\PaymentGatewayCallback;
use App\Models\PaymentTransaction;
use App\Models\QrTicket;
use Illuminate\Support\Facades\DB;
use InvalidArgumentException;
use Midtrans\Config;
use RuntimeException;

class MidtransCallbackService
{
    public function __construct(
        private MidtransStatusGateway $gateway,
        private ?QrTicketService $qrTicketService = null
    ) {
    }

    public function receive(array $payload): array
    {
        $required = [
            'order_id',
            'status_code',
            'gross_amount',
            'transaction_status',
            'signature_key',
        ];

        foreach ($required as $field) {
            if (
                !isset($payload[$field]) ||
                !is_string($payload[$field]) ||
                $payload[$field] === ''
            ) {
                throw new InvalidArgumentException(
                    'Payload Midtrans tidak lengkap.'
                );
            }
        }

        $serverKey = config('midtrans.server_key');

        if (!is_string($serverKey) || $serverKey === '') {
            throw new RuntimeException(
                'Konfigurasi Midtrans tidak tersedia.'
            );
        }

        // Verifikasi signature notifikasi.
        $expected = hash(
            'sha512',
            $payload['order_id']
                . $payload['status_code']
                . $payload['gross_amount']
                . $serverKey
        );

        if (!hash_equals($expected, $payload['signature_key'])) {
            throw new InvalidArgumentException(
                'Signature tidak valid.'
            );
        }

        $orderId = $payload['order_id'];

        $exists = PaymentTransaction::query()
            ->where('kode_bayar', $orderId)
            ->exists();

        if (!$exists) {
            throw new InvalidArgumentException(
                'Order tidak ditemukan.'
            );
        }

        // Ambil status terbaru dari Midtrans.
        Config::$serverKey = $serverKey;
        Config::$isProduction = (bool) config(
            'midtrans.is_production',
            false
        );

        $gateway = $this->gateway->getStatus($orderId);

        if ((string) ($gateway->order_id ?? '') !== $orderId) {
            throw new RuntimeException(
                'Order ID gateway tidak sesuai.'
            );
        }

        $gatewayAmount = $this->amount(
            (string) ($gateway->gross_amount ?? '')
        );

        $callbackAmount = $this->amount(
            $payload['gross_amount']
        );

        if ($gatewayAmount !== $callbackAmount) {
            throw new InvalidArgumentException(
                'Nominal notifikasi tidak sesuai.'
            );
        }

        $status = (string) (
            $gateway->transaction_status ?? ''
        );

        $statusCode = (string) (
            $gateway->status_code ?? ''
        );

        $fraud = strtolower(
            (string) ($gateway->fraud_status ?? '')
        );

        $nextStatus = match ($status) {
            'settlement' => $statusCode === '200'
                ? 'SUCCESS'
                : null,

            'capture' => (
                $statusCode === '200' &&
                $fraud === 'accept'
            ) ? 'SUCCESS' : null,

            'deny' => 'FAILED',
            'cancel' => 'CANCELLED',
            'expire' => 'EXPIRED',

            default => null,
        };

        return DB::transaction(function () use (
            $orderId,
            $payload,
            $gatewayAmount,
            $status,
            $nextStatus
        ) {
            $payment = PaymentTransaction::query()
                ->where('kode_bayar', $orderId)
                ->lockForUpdate()
                ->firstOrFail();

            if (
                $this->amount((string) $payment->nominal)
                !== $gatewayAmount
            ) {
                throw new InvalidArgumentException(
                    'Nominal database tidak sesuai.'
                );
            }

            // Simpan audit callback tanpa signature.
            $safePayload = $payload;
            unset($safePayload['signature_key']);

            PaymentGatewayCallback::create([
                'transaction_id' => $payment->id,
                'status_callback' => $status,
                'signature_valid' => true,
                'raw_payload' => $safePayload,
                'received_at' => now(),
            ]);

            // Callback duplikat tidak boleh memproses ulang.
            if ($payment->status_pembayaran === $nextStatus) {
                return [
                    'status' => $payment->status_pembayaran,
                    'updated' => false,
                ];
            }

            // Status final tidak boleh ditimpa.
            if ($payment->status_pembayaran !== 'PENDING') {
                return [
                    'status' => $payment->status_pembayaran,
                    'updated' => false,
                    'requires_review' => true,
                ];
            }

            // Status pending atau status gateway yang belum final.
            if ($nextStatus === null) {
                return [
                    'status' => 'PENDING',
                    'updated' => false,
                ];
            }

            $booking = Booking::query()
                ->whereKey($payment->booking_id)
                ->lockForUpdate()
                ->firstOrFail();

            if (
                $nextStatus === 'SUCCESS' &&
                !in_array(
                    $booking->status_booking,
                    ['DRAFT', 'CONFIRMED'],
                    true
                )
            ) {
                throw new RuntimeException(
                    'Status booking perlu pemeriksaan manual.'
                );
            }

            $payment->status_pembayaran = $nextStatus;
            $payment->save();

            if ($nextStatus === 'SUCCESS') {
                // Konfirmasi booking setelah pembayaran berhasil.
                $booking->status_booking = 'CONFIRMED';
                $booking->save();

                /*
                 * Terbitkan QR pertama secara otomatis.
                 * Jangan membuat QR baru jika booking sudah
                 * memiliki riwayat QR, termasuk QR INVALID.
                 */
                $hasQrHistory = QrTicket::query()
                    ->where('booking_id', $booking->id)
                    ->exists();

                if (!$hasQrHistory) {
                    $qrService = $this->qrTicketService
                        ?? app(QrTicketService::class);

                    $qrService->generate($booking);
                }
            }

            return [
                'status' => $nextStatus,
                'updated' => true,
            ];
        });
    }

    private function amount(string $value): string
    {
        if (!preg_match('/^\d+(\.\d{1,2})?$/', $value)) {
            throw new InvalidArgumentException(
                'Format nominal tidak valid.'
            );
        }

        [$whole, $decimal] = array_pad(
            explode('.', $value, 2),
            2,
            '00'
        );

        $whole = ltrim($whole, '0');

        return ($whole === '' ? '0' : $whole)
            . '.'
            . str_pad($decimal, 2, '0');
    }
}

<?php

namespace App\Http\Controllers;

use App\Http\Requests\BookingRequest;
use App\Models\Booking;
use App\Models\QrTicket;
use App\Services\BookingService;
use App\Services\QrTicketService;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use InvalidArgumentException;
use RuntimeException;

class BookingController extends Controller
{
    public function __construct(
        protected BookingService $bookingService
    ) {
    }

    /**
     * Membuat booking baru milik pengguna yang sedang login.
     */
    public function store(BookingRequest $request): JsonResponse
    {
        $data = $request->validated();

        // Identitas akun selalu diambil dari token Sanctum.
        $data['user_id'] = $request->user()->id;

        try {
            $booking = $this->bookingService->createBooking($data);

            return response()->json([
                'success' => true,
                'message' => 'Booking berhasil dibuat.',
                'data' => $booking,
            ], 201);
        } catch (InvalidArgumentException $exception) {
            return response()->json([
                'success' => false,
                'message' => $exception->getMessage(),
            ], 422);
        }
    }

    /**
     * Mengambil riwayat booking milik pengguna yang sedang login.
     * QR aktif disajikan dengan format yang konsisten untuk frontend.
     */
    public function history(Request $request): JsonResponse
    {
        $bookings = $this->bookingService->getBookingHistory(
            (string) $request->user()->id
        );

        $data = $bookings->map(function (Booking $booking): array {
            $item = $booking->toArray();
            $ticket = $booking->activeQrTicket;

            $item['active_qr_ticket'] = $ticket
                ? $this->formatQrTicket($ticket)
                : null;

            return $item;
        });

        return response()->json([
            'success' => true,
            'message' => 'Riwayat booking berhasil diambil.',
            'data' => $data,
        ]);
    }

    /**
     * Mengambil QR aktif untuk booking milik pengguna.
     * Jika booking sudah dikonfirmasi tetapi belum pernah memiliki QR,
     * QR pertama diterbitkan. QR lama tidak otomatis diterbitkan ulang.
     */
    public function qrTicket(
        Request $request,
        Booking $booking,
        QrTicketService $qrTicketService
    ): JsonResponse {
        if (
            !$request->user() ||
            (string) $booking->user_id !== (string) $request->user()->id
        ) {
            return response()->json([
                'success' => false,
                'message' => 'Akses booking ditolak.',
            ], 403);
        }

        if ($booking->status_booking !== 'CONFIRMED') {
            return response()->json([
                'success' => false,
                'message' => 'QR hanya tersedia setelah booking dikonfirmasi.',
            ], 422);
        }

        $ticket = $booking->activeQrTicket()->first();

        if (!$ticket) {
            // QR lama yang sudah tidak aktif tidak boleh dibuat ulang otomatis.
            if ($booking->qrTickets()->exists()) {
                return response()->json([
                    'success' => false,
                    'message' => 'Tidak ada QR aktif. Silakan hubungi petugas untuk pemeriksaan.',
                ], 409);
            }

            try {
                $ticket = $qrTicketService->generate($booking);
            } catch (RuntimeException $exception) {
                // Permintaan bersamaan mungkin sudah menerbitkan QR.
                $ticket = $booking->activeQrTicket()->first();

                if (!$ticket) {
                    return response()->json([
                        'success' => false,
                        'message' => 'QR gagal diterbitkan. Silakan coba lagi.',
                    ], 409);
                }
            }
        }

        return response()->json([
            'success' => true,
            'message' => 'Data tiket QR berhasil diambil.',
            'data' => $this->formatQrTicket($ticket),
        ]);
    }

    /**
     * Meminta regenerasi QR untuk booking milik pengguna.
     * Aturan kelayakan regenerasi tetap ditentukan QrTicketService.
     */
    public function regenerateQrTicket(
        Request $request,
        Booking $booking,
        QrTicketService $qrTicketService
    ): JsonResponse {
        if (
            !$request->user() ||
            (string) $booking->user_id !== (string) $request->user()->id
        ) {
            return response()->json([
                'success' => false,
                'message' => 'Akses booking ditolak.',
            ], 403);
        }

        if ($booking->status_booking !== 'CONFIRMED') {
            return response()->json([
                'success' => false,
                'message' => 'Booking belum dikonfirmasi.',
            ], 422);
        }

        try {
            $ticket = $qrTicketService->regenerate($booking);
        } catch (RuntimeException $exception) {
            return response()->json([
                'success' => false,
                'message' => $exception->getMessage(),
            ], 409);
        }

        return response()->json([
            'success' => true,
            'message' => 'QR berhasil diperbarui.',
            'data' => $this->formatQrTicket($ticket),
        ]);
    }

    /**
     * Format respons QR yang dipakai oleh endpoint QR dan riwayat booking.
     */
    private function formatQrTicket(QrTicket $ticket): array
    {
        $expiredAt = $ticket->waktu_expired;

        return [
            'qr_ticket_id' => $ticket->id,
            'booking_id' => $ticket->booking_id,
            'qr_payload' => $ticket->payload_signed,
            'status' => $ticket->status_qr,
            'issued_at' => $ticket->waktu_terbit?->toISOString(),
            'expires_at' => $expiredAt?->toISOString(),
            'is_expired' => !$expiredAt || $expiredAt->isPast(),
        ];
    }
}
